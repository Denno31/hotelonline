generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  password       String
  role           Role     @default(STAFF)
  currentShiftId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shifts         Shift[]
  currentShift   Shift?   @relation("CurrentShift", fields: [currentShiftId], references: [id])
}

model Guest {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  address      String?
  companyId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bills        Bill[]
  checkIns     CheckIn[]
  company      Company?      @relation(fields: [companyId], references: [id])
  reservations Reservation[]

  @@index([companyId])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]
  guests    Guest[]
}

model Room {
  id        String     @id @default(cuid())
  number    String     @unique
  type      RoomType
  rate      Float
  status    RoomStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bills     Bill[]
  checkIns  CheckIn[]
}

model CheckIn {
  id           String        @id @default(cuid())
  guestId      String
  roomId       String
  checkInDate  DateTime
  checkOutDate DateTime?
  status       CheckInStatus @default(ACTIVE)
  shiftId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bill         Bill?
  guest        Guest         @relation(fields: [guestId], references: [id])
  room         Room          @relation(fields: [roomId], references: [id])
  shift        Shift         @relation(fields: [shiftId], references: [id])
  reservation  Reservation?

  @@index([guestId])
  @@index([roomId])
  @@index([shiftId])
}

model Reservation {
  id        String   @id @default(cuid())
  guestId   String
  startDate DateTime
  endDate   DateTime
  status    String   @default("CONFIRMED")
  checkInId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id])
  guest     Guest    @relation(fields: [guestId], references: [id])

  @@index([guestId])
}

model Bill {
  id           String     @id @default(cuid())
  guestId      String
  companyId    String?
  roomId       String
  checkInId    String?    @unique
  total        Float      @default(0)
  status       String     @default("PENDING")
  checkInDate  DateTime
  checkOutDate DateTime?
  paidByBillId String?
  linkingDate  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  checkIn      CheckIn?   @relation(fields: [checkInId], references: [id])
  company      Company?   @relation(fields: [companyId], references: [id])
  guest        Guest      @relation(fields: [guestId], references: [id])
  paidByBill   Bill?      @relation("BillPayments", fields: [paidByBillId], references: [id])
  paidBills    Bill[]     @relation("BillPayments")
  room         Room       @relation(fields: [roomId], references: [id])
  items        BillItem[]
  charges      Charge[]
  payments     Payment[]

  @@index([guestId])
  @@index([companyId])
  @@index([roomId])
  @@index([checkInId])
  @@index([paidByBillId])
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  description String
  amount      Float
  type        String
  date        DateTime
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bill        Bill     @relation(fields: [billId], references: [id])

  @@index([billId])
}

model Payment {
  id        String        @id @default(cuid())
  billId    String
  amount    Float
  method    PaymentMethod
  reference String?
  date      DateTime
  shiftId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bill      Bill          @relation(fields: [billId], references: [id])
  shift     Shift         @relation(fields: [shiftId], references: [id])

  @@index([billId])
  @@index([shiftId])
}

model Charge {
  id          String   @id @default(cuid())
  billId      String
  amount      Float
  description String
  type        String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bill        Bill     @relation(fields: [billId], references: [id])

  @@index([billId])
}

model SystemDate {
  id          String   @id @default(cuid())
  currentDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id          String      @id @default(cuid())
  userId      String
  startTime   DateTime
  endTime     DateTime?
  cashInHand  Float?
  status      ShiftStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  checkIns    CheckIn[]
  payments    Payment[]
  user        User        @relation(fields: [userId], references: [id])
  currentUser User?       @relation("CurrentShift")

  @@index([userId])
}

enum Role {
  ADMIN
  STAFF
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  DELUXE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum CheckInStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BillItemType {
  ACCOMMODATION
  FOOD
  BEVERAGE
  SERVICE
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_MONEY
}

enum ShiftStatus {
  ACTIVE
  ENDED
}
